APP_NAME="Digital Agency Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logs : mots de passe, jetons, n° CNI, e-mails, téléphones et numéros de carte
# sont masqués sur tous les canaux (App\Logging\MasquageDonneesSensibles).
# En production :
#   APP_DEBUG=false          (sinon les erreurs s'affichent avec leurs données)
#   LOG_STACK=daily          (un fichier par jour, droits 0640)
#   LOG_DAILY_DAYS=14        (les logs de plus de 14 jours sont supprimés)
#   LOG_LEVEL=warning        (ni debug ni info : seulement les anomalies)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@agencydag.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo (MAIL_MAILER=brevo) : clé API transactionnelle, à créer dans Brevo >
# SMTP & API > Clés API. L'adresse MAIL_FROM_ADDRESS doit être un expéditeur
# validé chez Brevo (domaine authentifié SPF / DKIM).
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paiement en ligne et retraits : "simulation" (local), "moneroo" ou "fapshi"
PAIEMENT_PASSERELLE=simulation
# Secret du webhook défini dans app.moneroo.io > Developers > Webhooks
PAIEMENT_WEBHOOK_SECRET=
# Clé secrète Moneroo (test_... en sandbox)
MONEROO_SECRET_KEY=

# Fapshi (PAIEMENT_PASSERELLE=fapshi) : Orange Money et MTN MoMo uniquement.
# Test : https://sandbox.fapshi.com ; production : https://live.fapshi.com,
# chacun avec ses identifiants (tableau de bord Fapshi > service > API).
FAPSHI_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Même valeur que le secret de webhook saisi sur le tableau de bord Fapshi.
FAPSHI_WEBHOOK_SECRET=
# true seulement si Fapshi a activé le paiement direct (demande sur le téléphone).
FAPSHI_PAIEMENT_DIRECT=false

# Google reCAPTCHA v2 (case « Je ne suis pas un robot ») sur la connexion,
# l'inscription, le mot de passe oublié et les formulaires publics.
# Désactivé tant qu'une des deux clés est vide. Clés et domaines autorisés :
# https://www.google.com/recaptcha/admin (ajouter localhost pour tester en local).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mentions légales de DAG sur les factures (affichées seulement si renseignées)
DAG_RCCM=
DAG_NIU=
DAG_MENTION_TVA=
